# 复制为 .env 后按需修改；不建 .env 时用下面的默认值（连 Docker 里的 PostgreSQL）

# 默认：Docker Compose 里的 PostgreSQL（宿主机端口 5433，避开本地已装的 5432）
DATABASE_URL=postgresql+psycopg://psm:psm_dev_password@localhost:5433/logix_pms

# docker compose 使用的宿主机端口，改了要同步改上面的 DATABASE_URL
POSTGRES_PORT=5433

# 想退回 SQLite（零依赖、单文件）就解开下面这行
# DATABASE_URL=sqlite:///./logix_pms.db

# 令牌签名密钥。生产环境必须换成随机串：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=logix-pms-dev-secret-change-me

# 仅本地演示允许默认密钥启动。生产必须删除这一行，并换成上面的随机 SECRET_KEY。
ALLOW_DEV_SECRET=true

# 令牌有效期（秒），默认 12 小时
TOKEN_TTL_SECONDS=43200

# 本地演示：空库启动时灌入演示账号。生产必须设为 false，再跑 python -m scripts.bootstrap。
SEED_ON_STARTUP=true

# 生产环境示例（不要直接沿用上面的开发默认值）：
# ALLOW_DEV_SECRET=false
# SEED_ON_STARTUP=false
# SECRET_KEY=<随机串>
# POSTGRES_PASSWORD=<强口令>
# CORS_ORIGINS=https://pms.example.com
# 首次部署执行：python -m scripts.bootstrap
# 自动化时可提供 BOOTSTRAP_ADMIN_USERNAME / BOOTSTRAP_ADMIN_PASSWORD

# 外部托管 PostgreSQL：覆盖容器内连接串（docker compose 用）
# DATABASE_URL_DOCKER=postgresql+psycopg://user:password@db.example.com:5432/logix_pms

# CORS 允许来源，逗号分隔。不要在生产使用 *。
CORS_ORIGINS=http://127.0.0.1:8123,http://localhost:8123

# 打印 SQL
SQL_ECHO=false

# 交付物文件存储：本地卷目录与单文件大小上限（Docker 里默认 /app/var/attachments）
# ATTACHMENT_DIR=./var/attachments
# ATTACHMENT_MAX_MB=50
# ATTACHMENT_ALLOWED_EXTENSIONS=.xlsx,.xlsm,.docx,.pptx,.pdf,.bpmn,.xml,.csv,.txt,.md,.png,.jpg,.jpeg,.vsdx,.zip

# 附件预览：none=只内联 PDF/图片/文本；libreoffice=把 docx/xlsx/pptx 转 PDF；
# http=把源文件 POST 给外部适配器（ODA/APS/自建服务），支持 vsdx/dwg/dxf。
# 需要镜像内安装 LibreOffice：docker build --build-arg INSTALL_PREVIEW_CONVERTER=true
# PREVIEW_CONVERTER=libreoffice
# PREVIEW_CONVERTER_URL=http://preview-adapter:9000/convert
# PREVIEW_CONVERTER_TOKEN=
# PREVIEW_CONVERT_TIMEOUT_SECONDS=120
# PREVIEW_CONVERT_MAX_MB=200

# 测试用：设了就针对该库跑测试（会先 drop 全部表）
# TEST_DATABASE_URL=postgresql+psycopg://psm:psm_dev_password@localhost:5432/logix_pms_test

# 独立 draw.io 白板（架构草图）；生产建议自托管，避免草图内容发往外部服务
# DRAWIO_EMBED_URL=https://embed.diagrams.net/?embed=1&proto=json&spin=1&libraries=1&saveAndExit=1
